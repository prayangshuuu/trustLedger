# TrustLedger Unified Environment Configuration
# Copy this file to .env and fill in secrets (e.g. DEEPSEEK_API_KEY).
# Both local runtime (FastAPI, uvicorn) and Docker Compose use .env.
# Empty values fall back to the safe defaults in backend/app/config.py and docker-compose.yml.

# --- 1. Database and Cache -----------------------------------------------------
# PostgreSQL credentials (used by Docker Compose and local containers)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustledger
# Local: postgresql+psycopg://postgres:postgres@localhost:5432/trustledger
# Docker: postgresql://postgres:postgres@postgres:5432/trustledger
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trustledger
# Local: redis://localhost:6379/0 | Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- 2. LLMs and AI Services (DeepSeek & OCR) ---------------------------------
# mock (offline, deterministic) | live (calls live DeepSeek API, requires DEEPSEEK_API_KEY)
LLM_MODE=mock
DEEPSEEK_API_KEY=
# Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fast chat/extraction model (default: deepseek-chat)
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Reasoning model for complex decisions (default: deepseek-reasoner)
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# Base URL for DeepSeek-OCR OpenAI-compatible endpoint (without /chat/completions)
DEEPSEEK_OCR_URL=
DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_API_KEY=
# auto | deepseek-ocr-local | tesseract | mock
OCR_BACKEND=auto
# Per-session token budget (default: 50000)
LLM_SESSION_TOKEN_BUDGET=50000

# --- 3. RAG and Embeddings ----------------------------------------------------
# hash (offline fast hashing) | bge-m3 (dense multilingual embeddings)
EMBEDDINGS_MODE=hash
# lexical (BM25 token overlap) | bge (cross-encoder neural reranker)
RERANKER_MODE=lexical
# true enables LLM-based context compression before prompt synthesis
RAG_COMPRESSION=false

# --- 4. Object Storage & Encryption (Cloudflare R2 / MinIO) -------------------
# MinIO root credentials (used by Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# S3/R2 endpoint: empty R2_ENDPOINT falls back to local filesystem storage
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=trustledger
# Fernet 32-byte key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
# Local filesystem directory fallback when R2_ENDPOINT is empty
DOCUMENT_STORAGE_DIR=.storage/documents

# --- 5. Security, Authentication & Rate Limiting -------------------------------
# Comma-separated lender / partner API keys (empty = open dev mode without key validation)
API_KEYS=dev-key
# API key baked into the Flutter web borrower build (must match one of API_KEYS)
APP_API_KEY=dev-key
# Keys accepted by the MCP server HTTP transport (falls back to API_KEYS if empty)
MCP_API_KEYS=dev-key
# HMAC secret for borrower session tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-session-secret-key-for-local-dev
# Allowed browser origins for CORS (comma-separated dashboard and mobile origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=300
MAX_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=8000000

# --- 6. Application, Demo and Seeds -------------------------------------------
# true enables raw SMS demo parsing (/parse/sms, /apply) and pre-seeded demo personas
DEMO_MODE=true
# Number of synthetic applicants seeded on initial startup
SEED_POPULATION=4000
# Built React lender dashboard directory served at /
DASHBOARD_DIR=apps/dashboard/dist
# Built Flutter web borrower app directory served at /app/
BORROWER_WEB_DIR=apps/mobile/build/web
# Trained LightGBM model artifact directory
MODEL_DIR=models
GIT_SHA=
PORT=8000

# --- 7. Workflows, MCP & Monitoring -------------------------------------------
# Local: localhost:7233 | Docker: temporal:7233
TEMPORAL_HOST=localhost:7233
# Internal API URL called by MCP server, Temporal activities, and Airflow DAGs
TRUSTLEDGER_API_URL=http://localhost:8000
TRUSTLEDGER_API_KEY=dev-key
# inprocess = MCP server runs API directly in-process; http = calls external API
TRUSTLEDGER_BACKEND=
# Grafana admin dashboard password
GRAFANA_ADMIN_PASSWORD=admin
