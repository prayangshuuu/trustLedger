# TrustLedger environment. Copy to .env and fill in. Secrets come only from the environment;
# .env is git-ignored. Empty values fall back to the safe defaults in backend/app/config.py.

# --- Database and cache ------------------------------------------------------
# PostgreSQL 16 + pgvector, e.g. postgresql://postgres:postgres@localhost:5432/trustledger
DATABASE_URL=
# e.g. redis://localhost:6379/0 (reserved for caching / multi-dyno rate limits)
REDIS_URL=

# --- LLMs ---------------------------------------------------------------------
# mock (offline, deterministic) | live (needs DEEPSEEK_API_KEY)
LLM_MODE=mock
DEEPSEEK_API_KEY=
# default https://api.deepseek.com
DEEPSEEK_BASE_URL=
# default deepseek-chat
DEEPSEEK_CHAT_MODEL=
# default deepseek-reasoner
DEEPSEEK_REASONER_MODEL=
# OpenAI-compatible server hosting DeepSeek-OCR (vLLM / SGLang / hosted), base URL without /chat/completions
DEEPSEEK_OCR_URL=
# default deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_MODEL=
# defaults to DEEPSEEK_API_KEY
DEEPSEEK_OCR_API_KEY=
# auto | deepseek-ocr-local | tesseract | mock
OCR_BACKEND=auto
# Per-session token budget (default 50000)
LLM_SESSION_TOKEN_BUDGET=50000

# --- RAG ----------------------------------------------------------------------
# hash (offline) | bge-m3 (needs `uv sync --extra rag-live`)
EMBEDDINGS_MODE=hash
# lexical | bge
RERANKER_MODE=lexical
# true enables context compression before LLM calls
RAG_COMPRESSION=false

# --- Object storage (Cloudflare R2 / MinIO); empty R2_ENDPOINT = local filesystem ---
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=trustledger
# Fernet key for document images: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
# local store path when R2_ENDPOINT is empty (default .storage/documents)
DOCUMENT_STORAGE_DIR=

# --- Security -------------------------------------------------------------------
# comma-separated lender / partner / app keys; empty = development mode without key checks
API_KEYS=
# HMAC secret for borrower session tokens: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# browser origins allowed to call the API (dashboard URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_PER_MINUTE=300
MAX_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=8000000

# --- App ------------------------------------------------------------------------
# true allows raw demo SMS in /parse/sms and /apply (never stored) and the /demo endpoints
DEMO_MODE=false
# Built lender dashboard served at / by the API (skipped when the folder has no index.html)
DASHBOARD_DIR=apps/dashboard/dist
# Borrower web app (Flutter web, built with --base-href /app/) served at /app
BORROWER_WEB_DIR=apps/mobile/build/web
MODEL_DIR=models
# set by the platform; shown by /version
GIT_SHA=
PORT=8000

# --- Workflows / MCP ----------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
# used by the MCP server, Temporal activities and Airflow tasks to call the API
TRUSTLEDGER_API_URL=http://localhost:8000
TRUSTLEDGER_API_KEY=
# keys accepted by the MCP HTTP transport (falls back to API_KEYS)
MCP_API_KEYS=
# inprocess = MCP server runs the API in-process (demos)
TRUSTLEDGER_BACKEND=

# --- Dashboard (build time, apps/dashboard/.env) --------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
