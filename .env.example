# ==============================================================================
# TrustLedger Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure the variables for your environment.
# Secrets must be provided via environment variables only; never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string (PostgreSQL 16 + pgvector)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/trustledger
DATABASE_URL=

# Redis cache and broker connection URL
# Example: redis://localhost:6379/0
REDIS_URL=

# ------------------------------------------------------------------------------
# LLM & AI Services (DeepSeek)
# ------------------------------------------------------------------------------
# DeepSeek API key for chat and completions
DEEPSEEK_API_KEY=

# DeepSeek API base URL
# Example: https://api.deepseek.com
DEEPSEEK_BASE_URL=

# DeepSeek-OCR endpoint URL for bills, receipts, and khata parsing
# Example: https://api.deepseek.com/ocr
DEEPSEEK_OCR_URL=

# LLM execution mode: 'mock' (offline tests with mock responses) or 'live'
LLM_MODE=

# ------------------------------------------------------------------------------
# Object Storage (Cloudflare R2 / S3 API)
# ------------------------------------------------------------------------------
# S3-compatible endpoint for Cloudflare R2 (or local MinIO/filesystem)
# Example: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Cloudflare R2 access key ID
R2_ACCESS_KEY=

# Cloudflare R2 secret access key
R2_SECRET_KEY=

# Cloudflare R2 bucket name for document/artifact storage
R2_BUCKET=

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Comma-separated list of authorized API keys for client & partner AI access
API_KEYS=

# ------------------------------------------------------------------------------
# Application & Workflow Settings
# ------------------------------------------------------------------------------
# Demo mode flag ('true' or 'false'). When true, raw SMS processing in API is permitted in-memory
DEMO_MODE=

# Temporal server host and port for loan lifecycle workflow orchestration
# Example: localhost:7233
TEMPORAL_HOST=

# Directory containing ML model artifacts (XGBoost models, metadata JSONs)
# Example: models
MODEL_DIR=
