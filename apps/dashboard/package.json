{
  "name": "trustledger-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "tsc -b --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "test": "node scripts/gen-tokens.mjs && vitest run",
    "e2e": "playwright test",
    "prebuild": "node scripts/gen-tokens.mjs && node scripts/copy-docs.mjs",
    "predev": "node scripts/gen-tokens.mjs && node scripts/copy-docs.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
