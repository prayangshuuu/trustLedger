# TrustLedger Docker Compose Environment Configuration
# This file matches .env.example exactly, with service names configured for Docker network.
# Used when running via Docker:
#   docker compose up --build
# Or via Makefile:
#   make docker-up

# --- 1. Database and Cache -----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustledger
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trustledger
REDIS_URL=redis://redis:6379/0

# --- 2. LLMs and AI Services (DeepSeek & OCR) ---------------------------------
LLM_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_OCR_URL=
DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_API_KEY=
OCR_BACKEND=auto
LLM_SESSION_TOKEN_BUDGET=50000

# --- 3. RAG and Embeddings ----------------------------------------------------
EMBEDDINGS_MODE=hash
RERANKER_MODE=lexical
RAG_COMPRESSION=false

# --- 4. Object Storage & Encryption (MinIO / S3) ------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
R2_ENDPOINT=http://minio:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=trustledger
STORAGE_ENCRYPTION_KEY=
DOCUMENT_STORAGE_DIR=.storage/documents

# --- 5. Security, Authentication & Rate Limiting -------------------------------
API_KEYS=dev-key
APP_API_KEY=dev-key
MCP_API_KEYS=dev-key
SESSION_SECRET=change-me-docker-local-session-secret
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
MAX_BODY_BYTES=1000000
MAX_UPLOAD_BYTES=8000000

# --- 6. Application, Demo and Seeds -------------------------------------------
DEMO_MODE=true
SEED_POPULATION=4000
DASHBOARD_DIR=apps/dashboard/dist
BORROWER_WEB_DIR=apps/borrower/dist
MODEL_DIR=models
GIT_SHA=
PORT=8000

# --- 7. Workflows, MCP & Monitoring -------------------------------------------
TEMPORAL_HOST=temporal:7233
TRUSTLEDGER_API_URL=http://api:8000
TRUSTLEDGER_API_KEY=dev-key
TRUSTLEDGER_BACKEND=
GRAFANA_ADMIN_PASSWORD=admin
